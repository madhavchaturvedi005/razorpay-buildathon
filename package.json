{
  "name": "razorpay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"env BACKEND_URL=http://localhost:4000 next dev\" \"tsx watch backend/src/server.ts\"",
    "dev:web": "next dev",
    "dev:api": "tsx watch backend/src/server.ts",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "start:api": "tsx backend/src/server.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.1",
    "hono": "^4.9.8",
    "@hono/node-server": "^1.19.3",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
